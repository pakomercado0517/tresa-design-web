---
import "../styles/global.css";
import NavBar from "../components/ui/NavBar.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="TresA Design - Soluciones digitales y desarrollo web profesional"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/android-chrome-192x192.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/android-chrome-512x512.png"
    />
    <script
      src="https://code.iconify.design/iconify-icon/1.0.8/iconify-icon.min.js"
    ></script>
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="TresA Design - Soluciones digitales y desarrollo web profesional"
    />
    <title>{title}</title>
  </head>
  <body class="font-display">
    <div
      class="relative flex h-auto min-h-screen w-full flex-col group/design-root"
    >
      <NavBar />
      <div class="layout-container flex h-full grow flex-col">
        <slot />
      </div>
      <!-- Footer -->
      <footer
        class="flex flex-col gap-6 px-5 py-12 md:py-20 text-center bg-[#0B0D19] border-t border-[#222949]"
      >
        <div class="max-w-[960px] mx-auto flex flex-col gap-8">
          <div class="flex flex-col items-center gap-4">
            <img
              src="/logotipo-editado.svg"
              alt="TresA Design Logo"
              class="h-32 w-auto"
            />
            <p class="text-slate-400 max-w-md mx-auto">
              Elevando empresas a través de ingeniería digital superior y diseño
              reflexivo.
            </p>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-8 mt-4">
            <a
              class="text-slate-400 hover:text-primary transition-colors text-sm font-medium"
              href="#">Política de Privacidad</a
            >
            <a
              class="text-slate-400 hover:text-primary transition-colors text-sm font-medium"
              href="#">Términos de Servicio</a
            >
            <a
              class="text-slate-400 hover:text-primary transition-colors text-sm font-medium"
              href="#">Carreras</a
            >
          </div>
          <div class="flex flex-wrap justify-center gap-6 mt-4">
            <a
              class="size-10 rounded-full bg-[#181d34] flex items-center justify-center text-slate-400 hover:bg-primary hover:text-white transition-all"
              href="#"
            >
              <iconify-icon icon="mdi:earth" width="20" height="20"
              ></iconify-icon>
            </a>
            <a
              class="size-10 rounded-full bg-[#181d34] flex items-center justify-center text-slate-400 hover:bg-primary hover:text-white transition-all"
              href="#"
            >
              <iconify-icon icon="mdi:email" width="20" height="20"
              ></iconify-icon>
            </a>
            <a
              class="size-10 rounded-full bg-[#181d34] flex items-center justify-center text-slate-400 hover:bg-primary hover:text-white transition-all"
              href="#"
            >
              <iconify-icon icon="mdi:rss" width="20" height="20"
              ></iconify-icon>
            </a>
          </div>
          <p class="text-slate-600 text-sm font-normal mt-8">
            © {year} TresA Design. Todos los derechos reservados.
          </p>
        </div>
      </footer>

      <!-- Floating Action Button (FAB) - WhatsApp -->
      <a
        href="https://wa.me/527831766652?text=¡Hola!%20Me%20interesa%20conocer%20más%20sobre%20sus%20servicios%20de%20desarrollo%20y%20diseño%20digital."
        target="_blank"
        rel="noopener noreferrer"
        class="fixed bottom-8 right-8 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-primary text-white shadow-lg shadow-blue-900/40 hover:bg-blue-600 hover:scale-110 transition-all focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-[#101322]"
        aria-label="Contactar por WhatsApp"
      >
        <iconify-icon icon="ic:round-whatsapp" width="28" height="28"
        ></iconify-icon>
      </a>
    </div>
  </body>
</html>
