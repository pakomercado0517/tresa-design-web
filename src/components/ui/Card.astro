---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class={`flex flex-col gap-6 rounded-lg border border-[#222949] bg-[#181d34] p-8 hover:border-primary/50 transition-colors group hover:shadow-2xl hover:shadow-primary/10 ${className}`}
>
  <slot />
</div>
