---
import Button from "./Button.astro";
---

<header
  class="sticky top-0 z-50 flex items-center justify-between whitespace-nowrap border-b border-solid border-b-[#222949]/50 bg-[#101322]/80 backdrop-blur-md px-10 py-4 transition-all duration-300"
>
  <div
    class="flex items-center gap-4 text-white cursor-pointer hover:opacity-80 transition-opacity"
  >
    <div
      class="size-8 flex items-center justify-center bg-primary rounded-lg text-white"
    >
      <span class="material-symbols-outlined !text-[20px]">architecture</span>
    </div>
    <h2 class="text-white text-xl font-bold leading-tight tracking-[-0.015em]">
      TresA Design
    </h2>
  </div>

  <div class="flex flex-1 justify-end gap-8 hidden md:flex">
    <div class="flex items-center gap-9">
      <a
        class="text-slate-300 hover:text-primary text-sm font-medium leading-normal transition-colors"
        href="/services"
      >
        Servicios
      </a>
      <a
        class="text-slate-300 hover:text-primary text-sm font-medium leading-normal transition-colors"
        href="#projects"
      >
        Portafolio
      </a>
      <a
        class="text-slate-300 hover:text-primary text-sm font-medium leading-normal transition-colors"
        href="#about"
      >
        Sobre Nosotros
      </a>
    </div>
    <Button variant="primary" size="sm">Solicitar Cotización</Button>
  </div>

  <!-- Mobile Menu Icon -->
  <button
    id="mobile-menu-btn"
    class="md:hidden text-white cursor-pointer p-2 hover:opacity-80 transition-opacity"
    aria-label="Abrir menú"
  >
    <span class="material-symbols-outlined" id="menu-icon">menu</span>
  </button>
</header>

<!-- Mobile Menu -->
<div
  id="mobile-menu"
  class="hidden fixed top-16 left-0 right-0 bg-[#101322] border-b border-solid border-b-[#222949]/50 z-40 md:hidden"
>
  <nav class="flex flex-col gap-4 px-10 py-6">
    <a
      class="text-slate-300 hover:text-primary text-sm font-medium leading-normal transition-colors"
      href="/services"
    >
      Servicios
    </a>
    <a
      class="text-slate-300 hover:text-primary text-sm font-medium leading-normal transition-colors"
      href="#projects"
    >
      Portafolio
    </a>
    <a
      class="text-slate-300 hover:text-primary text-sm font-medium leading-normal transition-colors"
      href="#about"
    >
      Sobre Nosotros
    </a>
    <div class="pt-4">
      <Button variant="primary" size="sm">Solicitar Cotización</Button>
    </div>
  </nav>
</div>

<script>
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon");

  mobileMenuBtn?.addEventListener("click", () => {
    const isHidden = mobileMenu?.classList.contains("hidden");
    if (isHidden) {
      mobileMenu?.classList.remove("hidden");
      menuIcon!.textContent = "close";
    } else {
      mobileMenu?.classList.add("hidden");
      menuIcon!.textContent = "menu";
    }
  });

  // Cerrar menú al hacer click en un enlace
  const links = mobileMenu?.querySelectorAll("a");
  links?.forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      menuIcon!.textContent = "menu";
    });
  });
</script>
