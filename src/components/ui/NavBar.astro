---
import Button from "./Button.astro";

const pathname = new URL(Astro.request.url).pathname;

const isActive = (href: string) => {
  if (href === "/") {
    return pathname === "/";
  }
  return pathname.startsWith(href);
};
---

<header
  class="sticky top-0 z-50 flex items-center justify-between whitespace-nowrap border-b border-solid border-b-[#222949]/50 bg-[#101322]/80 backdrop-blur-md px-10 py-4 transition-all duration-300"
>
  <a
    href="/"
    class="flex items-center gap-4 text-white cursor-pointer hover:opacity-80 transition-opacity"
  >
    <img
      src="/logotipo-editado-1.svg"
      alt="TresA Design Logo"
      class="h-10 w-auto"
    />
    <h2 class="text-white text-xl font-bold leading-tight tracking-[-0.015em]">
      TresA Design
    </h2>
  </a>

  <div class="flex-1 justify-end gap-8 hidden md:flex">
    <div class="flex items-center gap-9">
      <a
        class={`text-sm font-medium leading-normal transition-colors pb-1 border-b-2 ${
          isActive("/")
            ? "text-primary border-primary"
            : "text-slate-300 border-transparent hover:text-primary"
        }`}
        href="/"
      >
        Inicio
      </a>
      <a
        class={`text-sm font-medium leading-normal transition-colors pb-1 border-b-2 ${
          isActive("/services")
            ? "text-primary border-primary"
            : "text-slate-300 border-transparent hover:text-primary"
        }`}
        href="/services"
      >
        Servicios
      </a>
      <a
        class={`text-sm font-medium leading-normal transition-colors pb-1 border-b-2 ${
          isActive("#projects")
            ? "text-primary border-primary"
            : "text-slate-300 border-transparent hover:text-primary"
        }`}
        href="#projects"
      >
        Portafolio
      </a>
      <a
        class={`text-sm font-medium leading-normal transition-colors pb-1 border-b-2 ${
          isActive("/about")
            ? "text-primary border-primary"
            : "text-slate-300 border-transparent hover:text-primary"
        }`}
        href="/about"
      >
        Sobre Nosotros
      </a>
    </div>
    <a href="/cta"
      ><Button variant="primary" size="sm">Solicitar Cotización</Button></a
    >
  </div>

  <!-- Mobile Menu Icon -->
  <button
    id="mobile-menu-btn"
    class="md:hidden text-white cursor-pointer p-2 hover:opacity-80 transition-opacity"
    aria-label="Abrir menú"
  >
    <iconify-icon icon="mdi:menu" id="menu-icon" width="24" height="24"
    ></iconify-icon>
  </button>
</header>

<!-- Mobile Menu -->
<div
  id="mobile-menu"
  class="hidden fixed top-16 left-0 right-0 bg-[#101322] border-b border-solid border-b-[#222949]/50 z-40 md:hidden"
>
  <nav class="flex flex-col gap-4 px-10 py-6">
    <a
      class={`text-sm font-medium leading-normal transition-colors pb-1 border-b-2 ${
        isActive("/")
          ? "text-primary border-primary"
          : "text-slate-300 border-transparent hover:text-primary"
      }`}
      href="/"
    >
      Inicio
    </a>
    <a
      class={`text-sm font-medium leading-normal transition-colors pb-1 border-b-2 ${
        isActive("/services")
          ? "text-primary border-primary"
          : "text-slate-300 border-transparent hover:text-primary"
      }`}
      href="/services"
    >
      Servicios
    </a>
    <a
      class={`text-sm font-medium leading-normal transition-colors pb-1 border-b-2 ${
        isActive("#projects")
          ? "text-primary border-primary"
          : "text-slate-300 border-transparent hover:text-primary"
      }`}
      href="#projects"
    >
      Portafolio
    </a>
    <a
      class={`text-sm font-medium leading-normal transition-colors pb-1 border-b-2 ${
        isActive("/about")
          ? "text-primary border-primary"
          : "text-slate-300 border-transparent hover:text-primary"
      }`}
      href="/about"
    >
      Sobre Nosotros
    </a>
    <div class="pt-4">
      <a href="/cta" class="inline-block"
        ><Button variant="primary" size="sm">Solicitar Cotización</Button></a
      >
    </div>
  </nav>
</div>

<script>
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon");

  mobileMenuBtn?.addEventListener("click", () => {
    const isHidden = mobileMenu?.classList.contains("hidden");
    if (isHidden) {
      mobileMenu?.classList.remove("hidden");
      menuIcon!.setAttribute("icon", "mdi:close");
    } else {
      mobileMenu?.classList.add("hidden");
      menuIcon!.setAttribute("icon", "mdi:menu");
    }
  });

  // Cerrar menú al hacer click en un enlace
  const links = mobileMenu?.querySelectorAll("a");
  links?.forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      menuIcon!.setAttribute("icon", "mdi:menu");
    });
  });
</script>
