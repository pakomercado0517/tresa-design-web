---
import { type Project } from "../../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const visibleTechs = project.technologies.slice(0, 2);
const remainingTechs = project.technologies.length - visibleTechs.length;
---

<a
  href={`/portfolio/${project.slug}`}
  data-category={project.category}
  data-project-card
  class="glass-card group flex flex-col rounded-[12px] overflow-hidden cursor-pointer"
>
  <div class="relative h-64 overflow-hidden bg-[#101323]">
    <img
      src={project.image}
      alt={project.title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#101323]/90 to-transparent opacity-60"></div>
    <div class="absolute top-4 right-4 bg-primary/20 backdrop-blur-md p-2 rounded-full border border-primary/30">
      <span class="material-symbols-outlined text-primary text-base leading-none">arrow_outward</span>
    </div>
  </div>

  <div class="p-6 flex-1 flex flex-col">
    <div class="flex items-center gap-2 mb-3">
      <span class="bg-[#222949] px-2 py-1 rounded text-[10px] uppercase tracking-wider font-bold text-primary">
        {project.category}
      </span>
    </div>

    <h3 class="text-xl font-bold text-white mb-2 leading-tight">
      {project.title}
    </h3>
    <p class="text-base text-[#909acb] mb-6 line-clamp-3 leading-relaxed">
      {project.shortDescription}
    </p>

    <div class="mt-auto flex flex-wrap gap-2">
      {visibleTechs.map((tech) => (
        <span class="bg-[#1a1b25] px-3 py-1 rounded text-xs font-semibold tracking-wide text-[#909acb] border border-[#222949]">
          {tech}
        </span>
      ))}
      {remainingTechs > 0 && (
        <span class="bg-[#1a1b25] px-3 py-1 rounded text-xs font-semibold tracking-wide text-[#909acb] border border-[#222949]">
          +{remainingTechs}
        </span>
      )}
    </div>
  </div>
</a>
