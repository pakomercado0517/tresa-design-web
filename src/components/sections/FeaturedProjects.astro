---
import { projects } from "../../data/projects";

const categoryStyles: Record<string, string> = {
  "Web App": "bg-blue-500/20 text-blue-400",
  Platform: "bg-amber-500/20 text-amber-400",
  Mobile: "bg-green-500/20 text-green-400",
  "E-commerce": "bg-rose-500/20 text-rose-400",
};

const featuredProjects = projects.filter(
  (project) => project.challenge && project.solution
);
---

<section class="px-4 md:px-10 py-20 flex justify-center" id="featured-projects">
  <div class="flex flex-col max-w-[1200px] flex-1 w-full">
    <div class="flex flex-col gap-10 md:gap-16">
      <div class="flex flex-col gap-4 max-w-[700px]">
        <h2 class="text-primary font-bold tracking-widest uppercase text-sm">
          Casos de Éxito
        </h2>
        <h1
          class="text-white text-4xl md:text-5xl font-bold leading-tight tracking-tight"
        >
          Transformando Retos en Éxito
        </h1>
        <p class="text-slate-400 text-lg font-normal leading-relaxed">
          Conoce cómo hemos ayudado a empresas a escalar sus operaciones y
          mejorar la experiencia de sus usuarios.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          featuredProjects.map((project) => (
            <a
              href={`/portfolio/${project.slug}`}
              class="flex flex-col gap-6 rounded-xl border border-[#222949] bg-[#181d34] p-6 md:p-8 hover:border-primary/50 transition-all group hover:shadow-2xl hover:shadow-primary/10"
            >
              <div>
                <h3 class="text-white text-2xl font-bold leading-tight mb-2 group-hover:text-primary transition-colors">
                  {project.title}
                </h3>
                <span
                  class={`inline-block px-3 py-1 rounded-full text-xs font-semibold ${categoryStyles[project.category] ?? "bg-primary/20 text-primary"}`}
                >
                  {project.category}
                </span>
              </div>

              <div class="flex flex-col gap-4 flex-1">
                {project.challenge && (
                  <div>
                    <p class="text-slate-300 text-xs font-bold uppercase tracking-widest mb-2">
                      El Reto
                    </p>
                    <p class="text-[#909acb] text-sm font-normal leading-relaxed line-clamp-3">
                      {project.challenge}
                    </p>
                  </div>
                )}

                {project.solution && (
                  <div>
                    <p class="text-slate-300 text-xs font-bold uppercase tracking-widest mb-2">
                      La Solución
                    </p>
                    <p class="text-[#909acb] text-sm font-normal leading-relaxed line-clamp-3">
                      {project.solution}
                    </p>
                  </div>
                )}
              </div>

              <div class="flex flex-wrap gap-2 pt-4 border-t border-[#222949]">
                {project.technologies.slice(0, 4).map((tech) => (
                  <span class="px-2 py-1 rounded-md bg-primary/10 text-primary text-xs font-medium">
                    {tech}
                  </span>
                ))}
                {project.technologies.length > 4 && (
                  <span class="px-2 py-1 rounded-md bg-[#222949] text-slate-400 text-xs font-medium">
                    +{project.technologies.length - 4}
                  </span>
                )}
              </div>
            </a>
          ))
        }
      </div>

      <div class="flex justify-center md:justify-start">
        <a
          href="/portfolio"
          class="inline-flex items-center gap-2 text-primary font-medium hover:text-white transition-colors"
        >
          Ver todos los proyectos
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>
    </div>
  </div>
</section>
