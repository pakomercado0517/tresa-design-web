---
import Card from "../ui/Card.astro";

const projects = [
  {
    title: "FinTech Dashboard",
    category: "Web App",
    categoryColor: "bg-blue-500/20 text-blue-400",
    challenge:
      "Visualización ágil de grandes volúmenes de transacciones financieras en tiempo real.",
    solution:
      "Creación de un dashboard moderno, intuitivo y performante con actualización en vivo.",
    technologies: ["React", "Node.js", "D3.js"],
  },
  {
    title: "E-commerce B2B",
    category: "Plataforma",
    categoryColor: "bg-amber-500/20 text-amber-400",
    challenge:
      "Control completo de inventarios y precios diferenciados por cliente integrado.",
    solution:
      "Sistema personalizado de gestión de pedidos y pagos con notificaciones push y seguimiento local seguro.",
    technologies: ["Next.js", "PostgreSQL", "Stripe"],
  },
  {
    title: "Health App",
    category: "Móvil",
    categoryColor: "bg-green-500/20 text-green-400",
    challenge:
      "Recordatorio de registros integrados complejos con portales de acceso.",
    solution:
      "App integrada (PWA) con notificaciones push y almacenamiento local seguro.",
    technologies: ["React Native", "Firebase", "Redis"],
  },
];
---

<section class="px-4 md:px-10 py-20 flex justify-center" id="featured-projects">
  <div class="flex flex-col max-w-[1200px] flex-1 w-full">
    <div class="flex flex-col gap-10 md:gap-16">
      <div class="flex flex-col gap-4 max-w-[700px]">
        <h2 class="text-primary font-bold tracking-widest uppercase text-sm">
          Casos de Éxito
        </h2>
        <h1
          class="text-white text-4xl md:text-5xl font-bold leading-tight tracking-tight"
        >
          Transformando Retos en Éxito
        </h1>
        <p class="text-slate-400 text-lg font-normal leading-relaxed">
          Conoce cómo hemos ayudado a empresas a escalar sus operaciones y
          mejorar la experiencia de sus usuarios.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          projects.map((project) => (
            <div class="flex flex-col gap-6 rounded-lg border border-[#222949] bg-[#181d34] p-8 hover:border-primary/50 transition-colors group hover:shadow-2xl hover:shadow-primary/10">
              <div class="flex items-start justify-between">
                <div>
                  <h3 class="text-white text-2xl font-bold leading-tight mb-2">
                    {project.title}
                  </h3>
                  <span
                    class={`inline-block px-3 py-1 rounded-full text-xs font-semibold ${project.categoryColor}`}
                  >
                    {project.category}
                  </span>
                </div>
              </div>

              <div class="flex flex-col gap-4 flex-1">
                <div>
                  <p class="text-slate-300 text-xs font-bold uppercase tracking-widest mb-2">
                    El Reto
                  </p>
                  <p class="text-[#909acb] text-sm font-normal leading-relaxed">
                    {project.challenge}
                  </p>
                </div>

                <div>
                  <p class="text-slate-300 text-xs font-bold uppercase tracking-widest mb-2">
                    La Solución
                  </p>
                  <p class="text-[#909acb] text-sm font-normal leading-relaxed">
                    {project.solution}
                  </p>
                </div>
              </div>

              <div class="flex flex-wrap gap-2 pt-4 border-t border-[#222949]">
                {project.technologies.map((tech) => (
                  <span class="px-2 py-1 rounded-md bg-primary/10 text-primary text-xs font-medium">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
