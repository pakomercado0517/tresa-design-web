---
import Button from "../ui/Button.astro";
---

<section
  class="flex flex-1 justify-center py-12 md:py-20 lg:py-24 px-4 md:px-10"
>
  <div class="flex flex-col max-w-[1200px] flex-1 w-full">
    <div
      class="flex min-h-[560px] flex-col gap-8 bg-cover bg-center bg-no-repeat rounded-xl items-center justify-center p-8 relative overflow-hidden group"
      style='background-image: linear-gradient(rgba(16, 19, 34, 0.7) 0%, rgba(16, 19, 34, 0.9) 100%), url("https://lh3.googleusercontent.com/aida-public/AB6AXuCCe_HqYkOhz-aM5hHiJjIKrDumOHSTtfhqUA-tjYHwZkhpv19oGIMtpKZSy3jqjnCfoZJQDKWHmz0cszu5Z97FPw6O8t9dCn5mrM_cDZsVxUpyJ4P_ln-jtjxJxU2jLvmDd-guRW9wA_dc4L4T09Rt-msKO9dFEEgSQuXxmq874kQ152yhoMs_xcGWNv6EW5_IG1pkg8Mmls-kVln5oOrkFcdSiA5_tN-MTfsjqa-zUNjjHHoXIc-Mxt_iHc29VOL9amFdPKTtNMfp");'
    >
      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent to-[#101322] opacity-90"
      >
      </div>

      <div
        class="flex flex-col gap-4 text-center z-10 max-w-[800px] animate-fade-in-up"
      >
        <span
          class="text-primary text-sm font-bold uppercase tracking-widest mb-2"
          >Innovación Digital</span
        >
        <h1
          class="text-white text-5xl md:text-6xl lg:text-7xl font-black leading-tight tracking-[-0.033em]"
        >
          Construyendo <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-primary"
            >Soluciones</span
          > para Mañana
        </h1>
        <h2
          class="text-slate-300 text-lg md:text-xl font-normal leading-relaxed max-w-[600px] mx-auto mt-4"
        >
          Desarrollo web y software engineering experto adaptado para escalar tu
          negocio con precisión y estilo.
        </h2>
      </div>

      <div class="flex flex-wrap gap-4 justify-center z-10 mt-6">
        <a href="/portfolio"
          ><Button variant="outline" size="md">Ver Nuestro Trabajo</Button></a
        >
        <a href="/contacto"
          ><Button variant="primary" size="md">Iniciar un Proyecto</Button></a
        >
      </div>
    </div>
  </div>
</section>
