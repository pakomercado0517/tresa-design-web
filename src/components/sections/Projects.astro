---
import { getProjectBySlug } from "../../data/projects";

const contafy = getProjectBySlug("contafy");
---

<section
  class="px-4 md:px-10 py-10 flex justify-center bg-[#15192e]"
  id="projects"
>
  <div class="flex flex-col max-w-[1200px] flex-1 w-full">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-2 mb-4">
        <h2 class="text-white text-3xl font-bold">Proyectos Destacados</h2>
        <p class="text-slate-400">
          Mira cómo ayudamos a las empresas a crecer.
        </p>
      </div>

      {
        contafy && (
          <a
            href={`/portfolio/${contafy.slug}`}
            class="block w-full rounded-xl overflow-hidden bg-[#101323] aspect-[21/9] relative group cursor-pointer shadow-2xl"
          >
            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors z-10"></div>
            <div
              class="w-full h-full bg-center bg-no-repeat bg-cover transition-transform duration-700 group-hover:scale-105"
              style={`background-image: url("${contafy.image}")`}
            >
            </div>
            <div class="absolute bottom-0 left-0 p-8 z-20 translate-y-4 group-hover:translate-y-0 transition-transform">
              <span class="inline-block mb-3 px-3 py-1 rounded-full bg-primary/20 border border-primary/30 text-primary text-xs font-semibold uppercase tracking-wider">
                {contafy.badge ?? contafy.category}
              </span>
              <h3 class="text-white text-2xl font-bold mb-2">{contafy.title}</h3>
              <p class="text-slate-200 opacity-0 group-hover:opacity-100 transition-opacity delay-100 max-w-2xl">
                {contafy.shortDescription}
              </p>
            </div>
          </a>
        )
      }
    </div>
  </div>
</section>
