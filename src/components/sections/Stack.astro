<section class="py-10 border-y border-[#222949] bg-[#101322]/50">
  <div class="max-w-[1200px] mx-auto px-4 md:px-10">
    <p
      class="text-center text-slate-500 text-sm font-medium mb-8 uppercase tracking-widest"
    >
      Impulsado por tecnologías modernas
    </p>
    <div
      class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-60 hover:opacity-100 transition-opacity duration-500 grayscale hover:grayscale-0"
    >
      <div class="flex items-center gap-2 text-white font-semibold text-lg">
        <iconify-icon icon="mdi:react" width="24" height="24"></iconify-icon> React
      </div>
      <div class="flex items-center gap-2 text-white font-semibold text-lg">
        <iconify-icon icon="mdi:language-javascript" width="24" height="24"
        ></iconify-icon> Node.js
      </div>
      <div class="flex items-center gap-2 text-white font-semibold text-lg">
        <iconify-icon icon="lineicons:postgresql" width="24" height="24"
        ></iconify-icon> PostgreSQL
      </div>
      <div class="flex items-center gap-2 text-white font-semibold text-lg">
        <iconify-icon icon="devicon-plain:astro" width="24" height="24"
        ></iconify-icon> Astro
      </div>
      <div class="flex items-center gap-2 text-white font-semibold text-lg">
        <iconify-icon
          icon="material-icon-theme:next-light"
          width="24"
          height="24"></iconify-icon> Next.js
      </div>
      <div class="flex items-center gap-2 text-white font-semibold text-lg">
        <iconify-icon icon="catppuccin:nest-gateway" width="24" height="24"
        ></iconify-icon> NestJS
      </div>
    </div>
  </div>
</section>
