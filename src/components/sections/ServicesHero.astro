---
import Button from "../ui/Button.astro";
---

<section
  class="flex flex-1 justify-center py-12 md:py-20 lg:py-24 px-4 md:px-10"
>
  <div
    class="flex flex-col max-w-[1200px] flex-1 w-full items-center text-center"
  >
    <div class="flex flex-col gap-6 max-w-[800px]">
      <h1
        class="text-white text-5xl md:text-6xl font-black leading-tight tracking-[-0.033em]"
      >
        Soluciones Digitales a Medida
      </h1>
      <p class="text-slate-300 text-lg md:text-xl font-normal leading-relaxed">
        Transformamos ideas complejas en productos digitales eficientes,
        escalables y seguros para impulsar el crecimiento de tu empresa.
      </p>
      <div class="flex flex-wrap gap-4 justify-center mt-4">
        <Button variant="primary" size="md">Ver Servicios</Button>
        <Button variant="outline" size="md">Nuestro Trabajo</Button>
      </div>
    </div>
  </div>
</section>
