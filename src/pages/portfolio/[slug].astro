---
import Layout from "../../layouts/Layout.astro";
import {
  getAdjacentProjects,
  getProjectBySlug,
  projects,
} from "../../data/projects";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/portfolio");
}

const project = getProjectBySlug(slug);

if (!project) {
  return Astro.redirect("/portfolio");
}

const { previous, next } = getAdjacentProjects(project.slug);
const galleryImages = project.images ?? [];
const headline = project.headline ?? project.title;
const badge = project.badge ?? project.category;
---

<Layout title={`${project.title} - Portafolio | TresA Design`}>
  <main>
    <!-- Hero -->
    <section class="relative min-h-[640px] flex items-center overflow-hidden py-20 px-6 md:px-8">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/4 left-0 w-80 h-80 bg-primary/10 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-[120px]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10 w-full">
        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            <span class="text-primary text-xs font-semibold uppercase tracking-wider">
              {badge}
            </span>
          </div>

          <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-[1.1]">
            {headline}
          </h1>

          <p class="text-[#909acb] text-lg leading-relaxed max-w-xl">
            {project.shortDescription}
          </p>

          <div class="flex flex-wrap gap-3 pt-2">
            {project.liveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-bold hover:opacity-90 transition-all shadow-[0_0_15px_rgba(13,51,242,0.4)]"
              >
                Ver sitio en vivo
                <span class="material-symbols-outlined text-base">open_in_new</span>
              </a>
            )}
            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 border border-[#222949] text-white px-6 py-3 rounded-lg font-bold hover:bg-[#1e1f29] transition-all"
              >
                Ver en GitHub
              </a>
            )}
          </div>
        </div>

        <div class="relative group">
          <div class="absolute -inset-1 bg-gradient-to-r from-primary to-[#2442fc] rounded-[12px] blur opacity-20 group-hover:opacity-40 transition duration-1000"></div>
          <div class="relative rounded-[12px] overflow-hidden border border-[#222949] shadow-2xl bg-[#1a1d2d]">
            <img
              src={project.image}
              alt={`${project.title} cover`}
              class="w-full h-auto object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Overview + Tech Stack -->
    <section class="py-12 md:py-20 px-6 md:px-8">
      <div class="max-w-[1280px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          <aside class="lg:col-span-4 order-2 lg:order-1">
            <div class="glass-card p-6 rounded-[12px] sticky top-24">
              <h3 class="text-xl font-bold text-white mb-6">Arquitectura Técnica</h3>

              <div class="flex flex-wrap gap-3">
                {project.technologies.map((tech) => (
                  <span class="bg-[#222949] text-[#c5c5da] text-xs font-semibold px-3 py-1.5 rounded uppercase tracking-wide">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="mt-8 pt-8 border-t border-[#222949] space-y-6">
                {project.client && (
                  <div>
                    <h4 class="text-primary text-sm font-medium mb-2">Cliente</h4>
                    <p class="text-[#909acb] text-base">{project.client}</p>
                  </div>
                )}
                <div>
                  <h4 class="text-primary text-sm font-medium mb-2">Categoría</h4>
                  <p class="text-[#909acb] text-base">{project.category}</p>
                </div>
                <div>
                  <h4 class="text-primary text-sm font-medium mb-2">Año</h4>
                  <p class="text-[#909acb] text-base">{project.year}</p>
                </div>
              </div>
            </div>
          </aside>

          <div class="lg:col-span-8 order-1 lg:order-2 space-y-16">
            {project.challenge && (
              <div>
                <h2 class="text-3xl font-black text-white tracking-tight mb-6">El Reto</h2>
                <p class="text-[#909acb] text-lg leading-relaxed">
                  {project.challenge}
                </p>
              </div>
            )}

            {project.objectives && project.objectives.length > 0 && (
              <div>
                <h2 class="text-3xl font-black text-white tracking-tight mb-6">El Objetivo</h2>
                <ul class="space-y-4">
                  {project.objectives.map((objective) => (
                    <li class="flex items-start gap-4">
                      <span class="material-symbols-outlined text-primary mt-1">check_circle</span>
                      <p class="text-[#909acb] text-lg leading-relaxed">{objective}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {!project.objectives?.length && project.description && (
              <div>
                <h2 class="text-3xl font-black text-white tracking-tight mb-6">Resumen</h2>
                <p class="text-[#909acb] text-lg leading-relaxed">{project.description}</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Solution / Features -->
    {(project.solution || (project.features && project.features.length > 0)) && (
      <section class="py-12 md:py-20 bg-[#0c0d17]/50">
        <div class="max-w-[1280px] mx-auto px-6 md:px-8">
          <div class="text-center mb-12 md:mb-16">
            <h2 class="text-3xl font-black text-white tracking-tight">La Solución</h2>
            {project.solution && (
              <p class="text-[#909acb] text-lg mt-4 max-w-2xl mx-auto leading-relaxed">
                {project.solution}
              </p>
            )}
          </div>

          {project.features && project.features.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              {project.features.map((feature, index) => {
                const wideIndex = project.features!
                  .slice(0, index)
                  .filter((item) => item.wide).length;
                const imageFirst = Boolean(feature.wide && feature.image && wideIndex % 2 === 1);

                if (!feature.wide) {
                  return (
                    <div class="glass-card p-6 rounded-[12px] flex flex-col items-start gap-4">
                      <div class="w-12 h-12 rounded-lg bg-primary/20 flex items-center justify-center text-primary">
                        <span
                          class="material-symbols-outlined"
                          style="font-variation-settings: 'FILL' 1;"
                        >
                          {feature.icon}
                        </span>
                      </div>
                      <h3 class="text-xl font-bold text-white">{feature.title}</h3>
                      <p class="text-[#909acb] leading-relaxed">{feature.description}</p>
                    </div>
                  );
                }

                return (
                  <div class="glass-card p-6 rounded-[12px] flex flex-col items-start gap-4 md:col-span-2">
                    <div class="flex flex-col md:flex-row gap-8 items-center w-full">
                      <div class:list={["flex-1 space-y-4", imageFirst && "order-1 md:order-2"]}>
                        <div class="w-12 h-12 rounded-lg bg-primary/20 flex items-center justify-center text-primary">
                          <span
                            class="material-symbols-outlined"
                            style="font-variation-settings: 'FILL' 1;"
                          >
                            {feature.icon}
                          </span>
                        </div>
                        <h3 class="text-xl font-bold text-white">{feature.title}</h3>
                        <p class="text-[#909acb] leading-relaxed">{feature.description}</p>
                      </div>
                      {feature.image && (
                        <div
                          class:list={[
                            "flex-1 w-full h-48 bg-[#101323] rounded-lg border border-[#222949] overflow-hidden",
                            imageFirst && "order-2 md:order-1",
                          ]}
                        >
                          <img
                            src={feature.image}
                            alt={feature.title}
                            class="w-full h-full object-cover"
                            loading="lazy"
                          />
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Impact -->
    {project.metrics && project.metrics.length > 0 && (
      <section class="py-12 md:py-20 px-6 md:px-8">
        <div class="max-w-[1280px] mx-auto">
          <div class="glass-card rounded-2xl p-8 md:p-12 bg-gradient-to-br from-[#1a1d2d] to-[#1a1b25] border-primary/20">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
              {project.metrics.map((metric) => (
                <div class="space-y-2">
                  <h3 class="text-4xl md:text-5xl font-black text-primary glow-text">
                    {metric.value}
                  </h3>
                  <p class="text-[#c5c5da] text-sm font-medium uppercase tracking-widest">
                    {metric.label}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Gallery -->
    {galleryImages.length > 0 && (
      <section class="py-12 md:py-20 px-6 md:px-8 bg-[#0c0d17]/30">
        <div class="max-w-[1280px] mx-auto">
          <h2 class="text-3xl font-black text-white tracking-tight mb-12">
            Galería del Producto
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {galleryImages.map((image) => (
              <div class="rounded-[12px] overflow-hidden border border-[#222949] group">
                <img
                  src={image}
                  alt={`${project.title} gallery`}
                  class="w-full h-auto transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Project Navigation -->
    {(previous || next) && (
      <section class="border-y border-[#222949]">
        <div class="max-w-[1280px] mx-auto flex flex-col md:flex-row md:divide-x divide-[#222949]">
          {previous ? (
            <a
              href={`/portfolio/${previous.slug}`}
              class="flex-1 py-10 md:py-12 px-6 group flex flex-col items-start hover:bg-[#1e1f29] transition-colors border-b md:border-b-0 border-[#222949]"
            >
              <span class="text-[#c5c5da] text-xs font-semibold uppercase mb-2 tracking-wide">
                Proyecto Anterior
              </span>
              <span class="text-white text-xl font-bold group-hover:translate-x-2 transition-transform inline-flex items-center gap-2">
                <span class="material-symbols-outlined">arrow_back</span>
                {previous.title}
              </span>
            </a>
          ) : (
            <div class="flex-1 py-10 md:py-12 px-6"></div>
          )}

          {next ? (
            <a
              href={`/portfolio/${next.slug}`}
              class="flex-1 py-10 md:py-12 px-6 group flex flex-col items-end hover:bg-[#1e1f29] transition-colors text-right"
            >
              <span class="text-[#c5c5da] text-xs font-semibold uppercase mb-2 tracking-wide">
                Proyecto Siguiente
              </span>
              <span class="text-white text-xl font-bold group-hover:-translate-x-2 transition-transform inline-flex items-center gap-2">
                {next.title}
                <span class="material-symbols-outlined">arrow_forward</span>
              </span>
            </a>
          ) : (
            <div class="flex-1 py-10 md:py-12 px-6"></div>
          )}
        </div>
      </section>
    )}

    <!-- Final CTA -->
    <section class="py-20 md:py-24 px-6 md:px-8 text-center">
      <div class="max-w-[1280px] mx-auto">
        <h2 class="text-4xl md:text-5xl font-black text-white mb-8 tracking-tight">
          ¿Listo para transformar tu presencia digital?
        </h2>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a
            href="/contacto"
            class="bg-primary text-white px-8 py-4 rounded-lg font-bold hover:scale-105 transition-all shadow-[0_0_20px_rgba(13,51,242,0.5)]"
          >
            Iniciar un proyecto
          </a>
          <a
            href="/portfolio"
            class="border border-[#222949] text-white px-8 py-4 rounded-lg font-bold hover:bg-[#1e1f29] transition-all"
          >
            Volver al Portafolio
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
