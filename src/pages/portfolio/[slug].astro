---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/ui/Button.astro";
import { getProjectBySlug, projects } from "../../data/projects";

// Función requerida para rutas dinámicas en Astro
export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

// Obtener el slug de la URL
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/portfolio");
}

// Buscar el proyecto
const project = getProjectBySlug(slug);

if (!project) {
  return Astro.redirect("/portfolio");
}

// Obtener proyectos relacionados (misma categoría, excluyendo el actual)
const relatedProjects = projects
  .filter(p => p.category === project.category && p.slug !== project.slug)
  .slice(0, 3);
---

<Layout title={`${project.title} - Portafolio | TresA Design`}>
  <!-- Hero Image Section -->
  <section class="relative w-full h-[60vh] min-h-[500px] flex items-center justify-center overflow-hidden bg-[#101323]">
    <div
      class="absolute inset-0 bg-cover bg-center transition-transform duration-700"
      style={`background-image: url("${project.image}")`}
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#101322]/80 via-[#101322]/60 to-[#101322]"></div>
    
    <div class="relative z-10 px-4 md:px-10 max-w-[1200px] w-full">
      <div class="flex flex-col gap-4">
        <span class="inline-block px-4 py-2 rounded-full bg-primary/20 text-primary text-sm font-semibold w-fit">
          {project.category}
        </span>
        <h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-black leading-tight tracking-[-0.033em] max-w-4xl">
          {project.title}
        </h1>
        <p class="text-slate-300 text-lg md:text-xl font-normal leading-relaxed max-w-2xl">
          {project.shortDescription}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="px-4 md:px-10 py-16 md:py-24 flex justify-center bg-[#101322]">
    <div class="flex flex-col max-w-[1200px] flex-1 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Content Column -->
        <div class="lg:col-span-2 flex flex-col gap-12">
          <!-- Description -->
          <div class="flex flex-col gap-4">
            <h2 class="text-white text-3xl font-bold">Resumen</h2>
            <p class="text-slate-400 text-lg font-normal leading-relaxed">
              {project.description}
            </p>
          </div>

          <!-- Challenge & Solution -->
          {project.challenge && project.solution && (
            <div class="flex flex-col gap-8">
              <div class="flex flex-col gap-4">
                <h3 class="text-primary text-sm font-bold uppercase tracking-widest">El Reto</h3>
                <p class="text-slate-300 text-base font-normal leading-relaxed">
                  {project.challenge}
                </p>
              </div>
              <div class="flex flex-col gap-4">
                <h3 class="text-primary text-sm font-bold uppercase tracking-widest">La Solución</h3>
                <p class="text-slate-300 text-base font-normal leading-relaxed">
                  {project.solution}
                </p>
              </div>
            </div>
          )}

          <!-- Gallery -->
          {project.images && project.images.length > 0 && (
            <div class="flex flex-col gap-6">
              <h2 class="text-white text-3xl font-bold">Galería</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {project.images.map((image) => (
                  <div
                    class="w-full aspect-video rounded-xl overflow-hidden bg-[#181d34]"
                  >
                    <div
                      class="w-full h-full bg-cover bg-center"
                      style={`background-image: url("${image}")`}
                    >
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1 flex flex-col gap-8">
          <div class="flex flex-col gap-6 p-6 rounded-xl bg-[#181d34] border border-[#222949]">
            <h3 class="text-white text-xl font-bold">Detalles del Proyecto</h3>
            
            <div class="flex flex-col gap-4">
              <div>
                <span class="text-slate-400 text-sm font-medium">Año</span>
                <p class="text-white text-base font-semibold">{project.year}</p>
              </div>
              
              {project.client && (
                <div>
                  <span class="text-slate-400 text-sm font-medium">Cliente</span>
                  <p class="text-white text-base font-semibold">{project.client}</p>
                </div>
              )}

              <div>
                <span class="text-slate-400 text-sm font-medium">Categoría</span>
                <p class="text-white text-base font-semibold">{project.category}</p>
              </div>
            </div>

            <div class="pt-4 border-t border-[#222949]">
              <span class="text-slate-400 text-sm font-medium block mb-3">Tecnologías</span>
              <div class="flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <span class="px-3 py-1.5 rounded-md bg-primary/10 text-primary text-sm font-medium">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-[#222949] flex flex-col gap-3">
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full"
                >
                  <Button variant="primary" size="md" class="w-full">
                    Ver Sitio en Vivo
                    <iconify-icon icon="mdi:open-in-new" width="20" height="20"></iconify-icon>
                  </Button>
                </a>
              )}
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full"
                >
                  <Button variant="outline" size="md" class="w-full">
                    Ver en GitHub
                    <iconify-icon icon="mdi:github" width="20" height="20"></iconify-icon>
                  </Button>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Projects -->
  {relatedProjects.length > 0 && (
    <section class="px-4 md:px-10 py-16 md:py-24 flex justify-center bg-[#15192e] border-t border-[#222949]">
      <div class="flex flex-col max-w-[1200px] flex-1 w-full">
        <div class="flex flex-col gap-8">
          <div class="flex flex-col gap-2">
            <h2 class="text-white text-3xl md:text-4xl font-bold">Proyectos Relacionados</h2>
            <p class="text-slate-400">
              Explora más proyectos en la misma categoría.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedProjects.map((relatedProject) => (
              <a
                href={`/portfolio/${relatedProject.slug}`}
                class="group flex flex-col rounded-xl overflow-hidden bg-[#181d34] border border-[#222949] hover:border-primary/50 transition-all duration-300 hover:shadow-2xl hover:shadow-primary/10"
              >
                <div class="relative w-full aspect-[4/3] overflow-hidden bg-[#101323]">
                  <div
                    class="w-full h-full bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
                    style={`background-image: url("${relatedProject.image}")`}
                  >
                  </div>
                </div>
                <div class="flex flex-col gap-2 p-6">
                  <h3 class="text-white text-lg font-bold group-hover:text-primary transition-colors">
                    {relatedProject.title}
                  </h3>
                  <p class="text-slate-400 text-sm line-clamp-2">
                    {relatedProject.shortDescription}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Back to Portfolio -->
  <section class="px-4 md:px-10 py-12 flex justify-center bg-[#101322] border-t border-[#222949]">
    <div class="flex flex-col max-w-[1200px] flex-1 w-full">
      <a
        href="/portfolio"
        class="inline-flex items-center gap-2 text-primary font-medium hover:text-white transition-colors w-fit"
      >
        <iconify-icon icon="mdi:arrow-left" width="20" height="20"></iconify-icon>
        Volver al Portafolio
      </a>
    </div>
  </section>
</Layout>

